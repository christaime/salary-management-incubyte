# ============================================================
# Salary Management — Environment Configuration
# ============================================================
# Copy this file to `.env` to override defaults.
# All variables are optional — the app runs with built-in defaults.
# ============================================================

# --- Database ---
# SQLite file path (relative to the backend/ working directory)
DB_URL=jdbc:sqlite:./data/salary-management.db

# Hikari connection pool size.
# Keep at 1 for SQLite (single-writer). Increase when moving to PostgreSQL.
DB_POOL_SIZE=1

# --- JPA / Hibernate ---
# Set to "validate" normally. Use "update" only for local experimentation.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# --- Flyway ---
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# --- Server ---
SERVER_PORT=8080

# --- Actuator ---
# Use "always" locally for full health details; "when-authorized" in production.
ACTUATOR_HEALTH_DETAILS=when-authorized

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG